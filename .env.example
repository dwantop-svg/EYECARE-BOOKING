# ฐานข้อมูล Postgres (เช่น Neon / Vercel Postgres)
DATABASE_URL=postgres://user:pass@host/db
# สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# ที่อยู่เว็บจริง ใช้สร้างลิงก์และ QR Code (ไม่ใส่ = ใช้โดเมนที่เปิดอยู่)
PUBLIC_BASE_URL=https://booking.example.com
